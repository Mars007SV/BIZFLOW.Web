@model BIZFLOW.Web.Models.User

@{
    ViewData["Title"] = "Профіль користувача";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Профіль користувача</h2>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateProfile" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ім'я користувача</label>
                            <input type="text" class="form-control" value="@Model.UserName" readonly />
                            <small class="form-text text-muted">Ім'я користувача не можна змінити</small>
                        </div>

                        <div class="mb-3">
                            <label for="fullName" class="form-label fw-bold">Повне ім'я</label>
                            <input type="text" class="form-control" id="fullName" name="fullName" value="@Model.FullName" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Дата реєстрації</label>
                            <input type="text" class="form-control" value="@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Останній вхід</label>
                            <input type="text" class="form-control" value="@Model.LastAccessAt.ToString("dd.MM.yyyy HH:mm")" readonly />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Зберегти зміни</button>
                            <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">Повернутися</a>
                            <a asp-action="Logout" asp-controller="Account" class="btn btn-danger ms-auto">Вийти</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
