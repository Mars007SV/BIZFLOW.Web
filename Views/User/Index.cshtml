@model IEnumerable<BIZFLOW.Web.Models.User>

@{
    ViewData["Title"] = "Список користувачів";
}

<div class="container mt-4">
    <h2>Список користувачів</h2>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Ім'я користувача</th>
                <th>Повне ім'я</th>
                <th>Створено</th>
                <th>Останній вхід</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.UserName</td>
                    <td>@(user.FullName ?? "-")</td>
                    <td>@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@user.LastAccessAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Активний</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Неактивний</span>
                        }

                        @if ((DateTime.Now - user.LastAccessAt).TotalMinutes < 5)
                        {
                            <span class="badge bg-info">Онлайн</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="alert alert-info">
        <strong>Всього користувачів:</strong> @Model.Count()
    </div>
</div>
