@model BIZFLOW.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Головна";
}

@if (!string.IsNullOrEmpty(ViewBag.UserName))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <strong>Вітаємо, @ViewBag.UserName!</strong> Ви увійшли в систему BIZFLOW.
        <a asp-controller="User" asp-action="Profile" class="alert-link">Переглянути профіль</a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="hero-section">
    <div class="text-center py-5">
        <h1 class="display-3 fw-bold text-primary mb-3">BIZFLOW</h1>
        <p class="lead text-muted mb-4">Професійна система управління товарними запасами</p>
        <p class="fs-5 mb-4">Контролюйте свій бізнес з легкістю та ефективністю</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">
                <i class="bi bi-box-seam"></i> Переглянути товари
            </a>
            <a asp-controller="Operations" asp-action="Index" class="btn btn-outline-info btn-lg px-4">
                <i class="bi bi-clock-history"></i> Історія операцій
            </a>
        </div>
    </div>
</div>

<!-- Ключові показники (Статистика) -->
<div class="row g-4 mb-5">
    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase mb-2">Всього товарів</h6>
                        <h2 class="mb-0 fw-bold text-primary">@Model.Statistics.TotalProducts</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-box-seam fs-2 text-primary"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-controller="Products" asp-action="Index" class="text-decoration-none small">
                        Переглянути всі <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase mb-2">В дефіциті</h6>
                        <h2 class="mb-0 fw-bold text-danger">@Model.Statistics.ProductsInDeficit</h2>
                    </div>
                    <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-exclamation-triangle fs-2 text-danger"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="text-muted small">
                        <i class="bi bi-info-circle"></i> Залишок менше 5 шт.
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase mb-2">Операції за тиждень</h6>
                        <h2 class="mb-0 fw-bold text-success">@Model.Statistics.RecentOperationsCount</h2>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-arrow-left-right fs-2 text-success"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-controller="Operations" asp-action="Index" class="text-decoration-none small">
                        Детальніше <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase mb-2">Категорій</h6>
                        <h2 class="mb-0 fw-bold text-info">@Model.Statistics.TotalCategories</h2>
                    </div>
                    <div class="bg-info bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-grid-3x3 fs-2 text-info"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-controller="Categories" asp-action="Index" class="text-decoration-none small">
                        Керувати <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Останні активності (Таблиця) -->
<div class="card border-0 shadow-sm mb-5">
    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-clock-history text-primary"></i> Останні активності
            </h5>
            <a asp-controller="Operations" asp-action="Index" class="btn btn-sm btn-outline-primary">
                Переглянути всі <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentActivities.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Товар</th>
                            <th>Тип операції</th>
                            <th>Кількість</th>
                            <th>Дата</th>
                            <th>Користувач</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in Model.RecentActivities)
                        {
                            var unitDisplay = activity.UnitOfMeasure switch
                            {
                                BIZFLOW.Web.Models.UnitOfMeasure.Kilograms => "кг",
                                BIZFLOW.Web.Models.UnitOfMeasure.Liters => "л",
                                _ => "шт"
                            };
                            <tr>
                                <td class="px-4">
                                    <strong>@activity.ProductName</strong>
                                </td>
                                <td>
                                    @if (activity.OperationType == "Прихід")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-arrow-down-circle"></i> @activity.OperationType
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-arrow-up-circle"></i> @activity.OperationType
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold">@activity.Quantity @unitDisplay</span>
                                </td>
                                <td>
                                    <span class="text-muted">@activity.Date.ToString("dd.MM.yyyy HH:mm")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(activity.UserName))
                                    {
                                        <i class="bi bi-person-circle text-muted"></i>
                                        <span>@activity.UserName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="text-muted mt-3">Поки що немає операцій</p>
            </div>
        }
    </div>
</div>

<div class="row g-4 py-5">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-box-seam" viewBox="0 0 16 16">
                        <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z"/>
                    </svg>
                </div>
                <h3 class="h4 mb-3">Управління товарами</h3>
                <p class="text-muted mb-4">Легко додавайте, редагуйте та відстежуйте всі ваші товари в одному місці</p>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">Перейти до товарів</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <div class="feature-icon bg-success bg-gradient text-white rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-grid-3x3" viewBox="0 0 16 16">
                        <path d="M0 1.5A1.5 1.5 0 0 1 1.5 0h13A1.5 1.5 0 0 1 16 1.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5zM1.5 1a.5.5 0 0 0-.5.5V5h4V1zM5 6H1v4h4zm1 4h4V6H6zm-1 1H1v3.5a.5.5 0 0 0 .5.5H5zm1 0v4h4v-4zm5 0v4h3.5a.5.5 0 0 0 .5-.5V11zm0-1h4V6h-4zm0-5h4V1.5a.5.5 0 0 0-.5-.5H11zm-1 0V1H6v4z"/>
                    </svg>
                </div>
                <h3 class="h4 mb-3">Категорії товарів</h3>
                <p class="text-muted mb-4">Організуйте товари за категоріями для кращої структури та аналітики</p>
                <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-success">Керувати категоріями</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <div class="feature-icon bg-info bg-gradient text-white rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16">
                        <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022zm2.004.45a7 7 0 0 0-.985-.299l.219-.976q.576.129 1.126.342zm1.37.71a7 7 0 0 0-.439-.27l.493-.87a8 8 0 0 1 .979.654l-.615.789a7 7 0 0 0-.418-.302zm1.834 1.79a7 7 0 0 0-.653-.796l.724-.69q.406.429.747.91zm.744 1.352a7 7 0 0 0-.214-.468l.893-.45a8 8 0 0 1 .45 1.088l-.95.313a7 7 0 0 0-.179-.483m.53 2.507a7 7 0 0 0-.1-1.025l.985-.17q.1.58.116 1.17zm-.131 1.538q.05-.254.081-.51l.993.123a8 8 0 0 1-.23 1.155l-.964-.267q.069-.247.12-.501m-.952 2.379q.276-.436.486-.908l.914.405q-.24.54-.555 1.038zm-.964 1.205q.183-.183.35-.378l.758.653a8 8 0 0 1-.401.432z"/>
                        <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0z"/>
                        <path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5"/>
                    </svg>
                </div>
                <h3 class="h4 mb-3">Історія операцій</h3>
                <p class="text-muted mb-4">Повний аудит всіх змін запасів з детальною інформацією про кожну операцію</p>
                <a asp-controller="Operations" asp-action="Index" class="btn btn-outline-info">Переглянути історію</a>
            </div>
        </div>
    </div>
</div>

<div class="row bg-light rounded-3 py-5 my-5">
    <div class="col-lg-6 mx-auto text-center">
        <h2 class="fw-bold mb-3">Чому обрати BIZFLOW?</h2>
        <p class="lead text-muted mb-4">Наша система надає всі необхідні інструменти для ефективного управління вашим складом</p>
        <ul class="list-unstyled text-start d-inline-block">
            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Простий та інтуїтивний інтерфейс</li>
            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Відстеження залишків у реальному часі</li>
            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Детальна історія всіх операцій</li>
            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Гнучка система категорій</li>
            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Швидкий пошук та фільтрація</li>
        </ul>
    </div>
</div>
