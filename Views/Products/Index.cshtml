@model IEnumerable<BIZFLOW.Web.Models.Product>

@{
    ViewData["Title"] = "Товари";
}

<h1>Товари</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Створити новий</a>
</p>

<!-- Форма пошуку та фільтрації -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <label for="searchString" class="form-label">Пошук за назвою</label>
            <input type="text" 
                   class="form-control" 
                   id="searchString" 
                   name="searchString" 
                   value="@ViewData["CurrentSearch"]" 
                   placeholder="Введіть назву товару...">
        </div>
        <div class="col-md-4">
            <label for="categoryFilter" class="form-label">Фільтр по категорії</label>
            <select class="form-select" 
                    id="categoryFilter" 
                    name="categoryFilter">
                <option value="">Всі категорії</option>
                @foreach (var category in ViewData["Categories"] as SelectList)
                {
                    <option value="@category.Value" selected="@(category.Value == ViewData["CurrentCategory"]?.ToString())">
                        @category.Text
                    </option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-success me-2">
                <i class="bi bi-search"></i> Знайти
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Скинути
            </a>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitOfMeasure)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        var unitDisplay = item.UnitOfMeasure switch
        {
            BIZFLOW.Web.Models.UnitOfMeasure.Kilograms => "кг",
            BIZFLOW.Web.Models.UnitOfMeasure.Liters => "л",
            _ => "шт"
        };
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @item.Quantity @unitDisplay
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitOfMeasure)
            </td>
            <td>
                @($"[{item.Category.Id}] {item.Category.Name}") 
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Редагувати</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Деталі</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a> |
                <a asp-controller="Operations" asp-action="ProductHistory" asp-route-id="@item.Id" class="text-info">Історія</a>
            </td>
        </tr>
}
    </tbody>
</table>
