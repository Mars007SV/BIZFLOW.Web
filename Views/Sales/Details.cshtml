@model BIZFLOW.Web.Models.Sale

@{
    ViewData["Title"] = "Деталі продажу";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <!-- Receipt/Check design -->
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0 text-center">ЧЕК</h4>
                </div>
                <div class="card-body">
                    <!-- Receipt header information -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <p class="mb-1"><strong>Номер чеку:</strong></p>
                            <p class="mb-1 text-muted">@Model.ReceiptNumber</p>
                        </div>
                        <div class="col-6 text-end">
                            <p class="mb-1"><strong>Дата та час:</strong></p>
                            <p class="mb-1 text-muted">@Model.SaleDate.ToString("dd.MM.yyyy HH:mm:ss")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CustomerName))
                    {
                        <div class="mb-3">
                            <p class="mb-1"><strong>Клієнт:</strong> @Model.CustomerName</p>
                        </div>
                    }

                    <hr />

                    <!-- Items table -->
                    <h5 class="mb-3">Товари:</h5>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>№</th>
                                <th>Найменування</th>
                                <th class="text-end">Кількість</th>
                                <th class="text-end">Ціна</th>
                                <th class="text-end">Сума</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int itemNumber = 1;
                            }
                            @foreach (var item in Model.SaleItems)
                            {
                                <tr>
                                    <td>@itemNumber</td>
                                    <td>@item.Product?.Name</td>
                                    <td class="text-end">@item.Quantity</td>
                                    <td class="text-end">@item.UnitPrice.ToString("F2") грн</td>
                                    <td class="text-end"><strong>@item.LineTotal.ToString("F2") грн</strong></td>
                                </tr>
                                itemNumber++;
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end"><strong>ВСЬОГО:</strong></td>
                                <td class="text-end">
                                    <h5 class="mb-0 text-success">@Model.TotalAmount.ToString("F2") грн</h5>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <hr />

                    <!-- Footer information -->
                    <div class="row mt-3">
                        @if (!string.IsNullOrEmpty(Model.CashierName))
                        {
                            <div class="col-6">
                                <p class="mb-1 small text-muted"><strong>Касир:</strong> @Model.CashierName</p>
                            </div>
                        }
                        <div class="col-6 text-end">
                            <p class="mb-1 small text-muted"><strong>Позицій:</strong> @Model.SaleItems.Count</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mt-3">
                            <p class="mb-1"><strong>Примітки:</strong></p>
                            <p class="text-muted small">@Model.Notes</p>
                        </div>
                    }

                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="small text-muted mb-0">Дякуємо за покупку!</p>
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="mt-3 text-center">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Повернутися до списку
                </a>
                <button onclick="window.print()" class="btn btn-primary">
                    <i class="bi bi-printer"></i> Друкувати чек
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Print styles -->
<style>
    @@media print {
        /* Hide navigation and buttons when printing */
        nav, .btn, footer {
            display: none !important;
        }

        /* Make the receipt take full width when printing */
        .col-md-8 {
            width: 100%;
            max-width: 100%;
        }

        /* Improve print layout */
        body {
            padding: 0;
            margin: 0;
        }

        .card {
            border: none;
            box-shadow: none;
        }

        /* Add page breaks */
        .card {
            page-break-after: always;
        }
    }

    /* Receipt styling */
    .card-header {
        font-family: 'Courier New', monospace;
    }

    .table {
        font-family: 'Courier New', monospace;
    }
</style>
