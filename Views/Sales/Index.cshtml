@model IEnumerable<BIZFLOW.Web.Models.Sale>

@{
    ViewData["Title"] = "Продажі";
}

<h1>Продажі</h1>

<p>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Створити новий продаж
    </a>
</p>

<!-- Search and filter form -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <label for="searchString" class="form-label">Пошук</label>
            <input type="text" 
                   class="form-control" 
                   id="searchString" 
                   name="searchString" 
                   value="@ViewData["CurrentFilter"]" 
                   placeholder="Номер чеку або клієнт...">
        </div>
        <div class="col-md-3">
            <label for="startDate" class="form-label">Дата від</label>
            <input type="date" 
                   class="form-control" 
                   id="startDate" 
                   name="startDate" 
                   value="@(ViewData["StartDate"] != null ? ((DateTime)ViewData["StartDate"]).ToString("yyyy-MM-dd") : "")">
        </div>
        <div class="col-md-3">
            <label for="endDate" class="form-label">Дата до</label>
            <input type="date" 
                   class="form-control" 
                   id="endDate" 
                   name="endDate" 
                   value="@(ViewData["EndDate"] != null ? ((DateTime)ViewData["EndDate"]).ToString("yyyy-MM-dd") : "")">
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2">
                <i class="bi bi-search"></i> Знайти
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Скинути
            </a>
        </div>
    </div>
</form>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Sales table -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Номер чеку</th>
            <th>Дата продажу</th>
            <th>Клієнт</th>
            <th>Кількість позицій</th>
            <th>Сума</th>
            <th>Касир</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">
                    Немає записів про продажі
                </td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@item.ReceiptNumber</strong>
                </td>
                <td>
                    @item.SaleDate.ToString("dd.MM.yyyy HH:mm")
                </td>
                <td>
                    @(item.CustomerName ?? "-")
                </td>
                <td>
                    @item.SaleItems.Count
                </td>
                <td>
                    <strong>@item.TotalAmount.ToString("C2")</strong>
                </td>
                <td>
                    @(item.CashierName ?? "-")
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i> Деталі
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Summary statistics -->
@if (Model.Any())
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Підсумок</h5>
            <div class="row">
                <div class="col-md-4">
                    <p class="mb-1"><strong>Всього продажів:</strong> @Model.Count()</p>
                </div>
                <div class="col-md-4">
                    <p class="mb-1"><strong>Всього позицій:</strong> @Model.Sum(s => s.SaleItems.Count)</p>
                </div>
                <div class="col-md-4">
                    <p class="mb-1"><strong>Загальна сума:</strong> @Model.Sum(s => s.TotalAmount).ToString("C2")</p>
                </div>
            </div>
        </div>
    </div>
}
