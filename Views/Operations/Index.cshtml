@model IEnumerable<BIZFLOW.Web.Models.Operation>

@{
    ViewData["Title"] = "Історія операцій";
}

<h1>Історія операцій</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Створити нову операцію</a>
</p>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Фільтри</h5>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="searchString" class="form-label">Пошук</label>
                    <input type="text" class="form-control" id="searchString" name="searchString" 
                           value="@ViewData["CurrentFilter"]" placeholder="Назва продукту або опис" />
                </div>
                <div class="col-md-2">
                    <label for="operationType" class="form-label">Тип операції</label>
                    <select class="form-select" id="operationType" name="operationType">
                        <option value="">Всі</option>
                        <option value="Incoming" selected="@(ViewData["CurrentType"]?.ToString() == "Incoming")">Надходження</option>
                        <option value="Outgoing" selected="@(ViewData["CurrentType"]?.ToString() == "Outgoing")">Списання</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="startDate" class="form-label">Дата від</label>
                    <input type="date" class="form-control" id="startDate" name="startDate" 
                           value="@(ViewData["StartDate"] != null ? ((DateTime)ViewData["StartDate"]).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-md-2">
                    <label for="endDate" class="form-label">Дата до</label>
                    <input type="date" class="form-control" id="endDate" name="endDate" 
                           value="@(ViewData["EndDate"] != null ? ((DateTime)ViewData["EndDate"]).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-success me-2">Застосувати</button>
                    <a asp-action="Index" class="btn btn-secondary">Очистити</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Operations Table -->
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParm"]" 
                       asp-route-searchString="@ViewData["CurrentFilter"]" 
                       asp-route-operationType="@ViewData["CurrentType"]"
                       asp-route-startDate="@ViewData["StartDate"]"
                       asp-route-endDate="@ViewData["EndDate"]">
                        @Html.DisplayNameFor(model => model.Date)
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["ProductSortParm"]" 
                       asp-route-searchString="@ViewData["CurrentFilter"]" 
                       asp-route-operationType="@ViewData["CurrentType"]"
                       asp-route-startDate="@ViewData["StartDate"]"
                       asp-route-endDate="@ViewData["EndDate"]">
                        @Html.DisplayNameFor(model => model.Product)
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["TypeSortParm"]" 
                       asp-route-searchString="@ViewData["CurrentFilter"]" 
                       asp-route-operationType="@ViewData["CurrentType"]"
                       asp-route-startDate="@ViewData["StartDate"]"
                       asp-route-endDate="@ViewData["EndDate"]">
                        @Html.DisplayNameFor(model => model.Type)
                    </a>
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Quantity)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.RemainingQuantity)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Description)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserName)
                </th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @item.Date.ToString("dd.MM.yyyy HH:mm")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Product.Name)
                </td>
                <td>
                    @if (item.Type == "Incoming")
                    {
                        <span class="badge bg-success">Надходження</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Списання</span>
                    }
                </td>
                <td>
                    @if (item.Type == "Incoming")
                    {
                        <span class="text-success">+@item.Quantity</span>
                    }
                    else
                    {
                        <span class="text-danger">-@item.Quantity</span>
                    }
                </td>
                <td>
                    <strong>@item.RemainingQuantity</strong>
                </td>
                <td>
                    @(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)
                </td>
                <td>
                    @(string.IsNullOrEmpty(item.UserName) ? "-" : item.UserName)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Деталі</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Видалити</a>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Операції не знайдені. Створіть першу операцію.
    </div>
}
