@model BIZFLOW.Web.Models.Operation

@{
    ViewData["Title"] = "Видалити операцію";
}

<h1>Видалити операцію</h1>

<h3 class="text-danger">Ви впевнені, що хочете видалити цю операцію?</h3>
<div class="card">
    <div class="card-header bg-danger text-white">
        <h4>Інформація про операцію</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Date)
            </dt>
            <dd class="col-sm-9">
                @Model.Date.ToString("dd.MM.yyyy HH:mm:ss")
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Product)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Product.Name)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Type)
            </dt>
            <dd class="col-sm-9">
                @if (Model.Type == "Incoming")
                {
                    <span class="badge bg-success">Надходження</span>
                }
                else
                {
                    <span class="badge bg-danger">Списання</span>
                }
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Quantity)
            </dt>
            <dd class="col-sm-9">
                @if (Model.Type == "Incoming")
                {
                    <span class="text-success"><strong>+@Model.Quantity</strong></span>
                }
                else
                {
                    <span class="text-danger"><strong>-@Model.Quantity</strong></span>
                }
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.RemainingQuantity)
            </dt>
            <dd class="col-sm-9">
                <strong>@Model.RemainingQuantity</strong> одиниць
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-9">
                @(string.IsNullOrEmpty(Model.Description) ? "Не вказано" : Model.Description)
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>
