@model BIZFLOW.Web.Models.Operation

@{
    ViewData["Title"] = "Деталі операції";
    var unitDisplay = Model.Product.UnitOfMeasure switch
    {
        BIZFLOW.Web.Models.UnitOfMeasure.Kilograms => "кг",
        BIZFLOW.Web.Models.UnitOfMeasure.Liters => "л",
        _ => "шт"
    };
}

<h1>Деталі операції</h1>

<div class="card">
    <div class="card-header">
        <h4>Інформація про операцію</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Date)
            </dt>
            <dd class="col-sm-9">
                @Model.Date.ToString("dd.MM.yyyy HH:mm:ss")
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Product)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Product.Name)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Type)
            </dt>
            <dd class="col-sm-9">
                @if (Model.Type == "Incoming")
                {
                    <span class="badge bg-success fs-6">Надходження</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Списання</span>
                }
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Quantity)
            </dt>
            <dd class="col-sm-9">
                @if (Model.Type == "Incoming")
                {
                    <span class="text-success fs-5"><strong>+@Model.Quantity @unitDisplay</strong></span>
                }
                else
                {
                    <span class="text-danger fs-5"><strong>-@Model.Quantity @unitDisplay</strong></span>
                }
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.RemainingQuantity)
            </dt>
            <dd class="col-sm-9">
                <strong>@Model.RemainingQuantity @unitDisplay</strong>
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-9">
                @(string.IsNullOrEmpty(Model.Description) ? "Не вказано" : Model.Description)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.UserName)
            </dt>
            <dd class="col-sm-9">
                @(string.IsNullOrEmpty(Model.UserName) ? "Не вказано" : Model.UserName)
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Повернутися до списку</a>
    <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">Видалити</a>
</div>
