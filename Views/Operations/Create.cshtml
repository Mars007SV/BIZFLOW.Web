@model BIZFLOW.Web.Models.Operation

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Operation</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ProductId" class="control-label"></label>
                <input list="products" id="productInput" class="form-control" placeholder="Почни вводити товар..." />

<datalist id="products">
    @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.ProductId)
    {
        <option value="@item.Text" data-id="@item.Value"></option>
    }
</datalist>

<input type="hidden" asp-for="ProductId" id="productIdHidden" />
            </div>
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Type" class="control-label"></label>
                <select asp-for="Type" class="form-control">
                    <option value="Incoming">Надходження</option>
                    <option value="Outgoing">Списання</option>
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" type="datetime-local" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('productInput').addEventListener('input', function(e) {
            var value = e.target.value;
            var options = document.querySelectorAll('#products option');
            var hiddenInput = document.getElementById('productIdHidden');

            hiddenInput.value = '';

            options.forEach(function(option) {
                if (option.value === value) {
                    hiddenInput.value = option.getAttribute('data-id');
                }
            });
        });
    </script>
}
